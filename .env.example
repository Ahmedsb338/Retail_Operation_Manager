# Gemini API key for server-side AI diagnostics
GEMINI_API_KEY=

# PostgreSQL Runtime Configuration (Supabase PostgreSQL / Cloud SQL)
# For Supabase Session Pooler (IPv4 compatible):
#   SQL_HOST=aws-0-<region>.pooler.supabase.com
#   SQL_PORT=5432
#   SQL_DB_NAME=postgres
#   SQL_USER=postgres.<project-ref>
#   SQL_PASSWORD=<your-supabase-db-password>
#   SQL_SSL=true
SQL_HOST=
SQL_PORT=5432
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_SSL=false

# Optional Admin Credentials (if using separate migration user)
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Optional: Split frontend/backend hosting (e.g. Cloudflare Workers static frontend -> Node Express backend)
VITE_API_BASE_URL=
ALLOWED_ORIGINS=
